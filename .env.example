# Local development configuration.
# Copy to .env and adjust as needed. .env is gitignored and must never be committed.

# PostgreSQL (Docker Compose)
POSTGRES_USER=webhook_inspector
POSTGRES_PASSWORD=webhook_inspector
POSTGRES_DB=webhook_inspector
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgres://webhook_inspector:webhook_inspector@localhost:5432/webhook_inspector
BACKEND_PORT=3000

# Optional: interface the backend listens on. Defaults to 127.0.0.1 locally;
# containers must set 0.0.0.0.
# BACKEND_HOST=127.0.0.1

# Optional: the trust boundary, as a comma-separated list of IP addresses or
# CIDR ranges (D111): the peers whose PROXY protocol header the receive
# listener accepts (D187), and whose X-Forwarded-For the application listener
# believes. Empty — the default — means none. Never a hop count; there is no
# numeric form.
# TRUSTED_PROXY_CIDRS=10.42.0.0/24

# Optional: the receive listener, a second server in the same process that
# receives webhooks at /s/ and nothing else (D187). Locally it is reached
# directly; receiveUrl names it. RECEIVE_ORIGIN is its public origin, an
# origin alone. RECEIVE_PROXY_PROTOCOL=v2 is production's: every connection
# must open with a PROXY protocol v2 header from a peer in TRUSTED_PROXY_CIDRS.
# RECEIVE_PORT=3001
# RECEIVE_ORIGIN=http://127.0.0.1:3001
# RECEIVE_PROXY_PROTOCOL=off

# Optional: RECEIVE_HTTP2=on serves a receive connection that opens with the
# HTTP/2 connection preface (h2c prior knowledge, after the PROXY header when
# RECEIVE_PROXY_PROTOCOL=v2) as HTTP/2, and stores its requests as HTTP/2
# (D263). off, the default and production's value until #115 switches it on,
# leaves every connection to the HTTP/1.1 parser. Any other value refuses to
# start.
# RECEIVE_HTTP2=off

# Optional: the site's public origin (D203), an origin alone: the inspector
# links the MCP endpoint /mcp gives, and the one Origin a browser may send it.
# The receive listener reads it too: a default session's answer links the
# request in the inspector there, as inspectorUrl (D223).
# Locally the frontend dev server's.
# APP_ORIGIN=http://localhost:5173

# Optional: the per-address limits of the API, per minute (D201). Unset, they
# are production's: 60 session creations and 1200 other calls under /api from
# one address, which /mcp shares (D203). Every local call comes from one
# address, so a script hammering a local backend may want more.
# RATE_LIMIT_SESSION_CREATES_PER_MINUTE=60
# RATE_LIMIT_API_CALLS_PER_MINUTE=1200
