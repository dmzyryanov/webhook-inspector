# Frontend image. Build from the repository root:
#   docker build -f apps/frontend/Dockerfile -t qa-tools-frontend .
#
# The result is static files behind Nginx and carries no configuration at run
# time: the application talks to its own origin. What the image names as its
# address is set when it is built (D274): the build arguments APP_ORIGIN, the
# site's origin, and RECEIVE_ORIGIN, the receive host's, which the pages'
# canonical links, the sitemap, robots.txt, security.txt, the feeds, the agent
# documentation, the relay script and /openapi.json name; and APP_ALIAS_ORIGIN
# (D275), the site's second origin, which the renamed relay script reads by
# default and the notice of the move names. Left unset, they are
# production's, https://qa-tools.ru, https://hook.qa-tools.ru and
# https://webhook.qa-tools.ru, the third only while the site is production's
# (apps/frontend/scripts/site-origin.mjs). A copy on another address builds
# its own image, with no second origin unless it gives one:
#   docker build -f apps/frontend/Dockerfile \
#     --build-arg APP_ORIGIN=https://inspector.example \
#     --build-arg RECEIVE_ORIGIN=https://hook.inspector.example \
#     -t qa-tools-frontend .
FROM node:24-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/frontend/package.json apps/frontend/

# Dev dependencies are needed here: the build runs tsc and Vite.
RUN npm ci --workspace @webhook-inspector/frontend --include-workspace-root

COPY tsconfig.base.json ./
# The source of /changelog, /changelog.md (D184) and the two Atom feeds
# (D212); .dockerignore lets this one root Markdown file through.
COPY CHANGELOG.md ./
COPY packages/shared packages/shared
COPY apps/frontend apps/frontend

# Declared after the installs, so that another address rebuilds from here.
ARG APP_ORIGIN
ARG RECEIVE_ORIGIN
ARG APP_ALIAS_ORIGIN
RUN npm run build --workspace @webhook-inspector/frontend

FROM nginx:1.29-alpine

COPY apps/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/frontend/dist /usr/share/nginx/html
# The built output holds openapi.json, served at /openapi.json by its own
# location in nginx.conf (D154): packages/shared/openapi.json under the
# image's origins, written by the build stage (scripts/build-site-files.mjs),
# byte for byte the file for production's. robots.txt, sitemap.xml and the
# relay script, webhook-inspector-relay.mjs (D275), are written there the
# same way, over Vite's copies from public/; the build writes the same bytes
# again as qa-tools-relay.mjs, the script's old name, which has no file in
# public/ (D279).
# The built output also holds the changelog (D184): changelog/index.html,
# served at /changelog, changelog.md, and the Atom feeds changelog.xml and
# changelog-breaking.xml (D212), all generated by the build stage from
# CHANGELOG.md.
# The built output also holds the about page (D211): about/index.html, served
# at /about, written by the build stage from src/lib/about-copy.ts.
# The built output also holds the Terms of Use and the Privacy Policy (D217):
# terms/index.html and privacy/index.html, served at /terms and /privacy,
# written by the build stage from src/lib/legal-copy.ts.
# The built output also holds llms.txt and llms-full.txt (D165), generated by
# the build stage from packages/shared/openapi.json and apps/frontend/llms/.
# The built output holds the API reference too: docs/index.html, served at
# /docs, and its content-hashed Scalar bundle under assets/ (D155). The build
# stage's `npm run build` already failed if Scalar reached the application.
#
# A configuration nginx refuses fails here, in the merge request's image build,
# rather than as a pod that never becomes ready.
RUN nginx -t

EXPOSE 80
